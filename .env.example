# ==============================================================
# Designterio Lead Notification Email Configuration
# ==============================================================

# Option 1: Gmail (Recommended for quick setup)
# Note: For Gmail, generate a 16-character "App Password" at:
# https://myaccount.google.com/apppasswords (Requires 2-Step Verification)
EMAIL_SERVICE=gmail
EMAIL_USER=your-business-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Email destination (Where enquiries should be delivered)
EMAIL_TO=info@designterio.com

# Optional sender display email
EMAIL_FROM=your-business-email@gmail.com

# Option 2: Custom SMTP (Zoho, Hostinger, AWS SES, Titan, etc.)
# Uncomment if not using standard Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
